"Leave empty for the translated default. %s is replaced with the names of the"
" visible systems."
msgstr ""
"Αφήστε το κενό για τη μεταφρασμένη προεπιλογή. Το %s αντικαθίσταται με τα "
"ονόματα των ορατών συστημάτων."

#. translators: %s is the literal placeholder token shown to the user.
#: admin/class-settings.php:583
msgid "Manage detected and declared AI systems"
msgstr "Διαχείριση εντοπισμένων και δηλωμένων συστημάτων AI"

#: admin/class-settings.php:593
msgid "Detect on upload"
msgstr "Ανίχνευση κατά τη μεταφόρτωση"

#: admin/class-settings.php:596
msgid ""
"Inspect new uploads for AI provenance (C2PA, XMP/IPTC, generator signatures)"
msgstr ""
"Έλεγχος των νέων μεταφορτώσεων για προέλευση AI (C2PA, XMP/IPTC, υπογραφές "
"γεννητριών)"

#: admin/class-settings.php:600
msgid "Standard declarations"
msgstr "Τυπικές δηλώσεις"

#: admin/class-settings.php:607 admin/class-settings.php:624
msgid "Label automatically"
msgstr "Αυτόματη ετικέτα"

#: admin/class-settings.php:608 admin/class-settings.php:625
msgid "Put into review queue"
msgstr "Τοποθέτηση στην ουρά ελέγχου"

#: admin/class-settings.php:609 admin/class-settings.php:626
msgid "Ignore"
msgstr "Παράβλεψη"

#: admin/class-settings.php:613
