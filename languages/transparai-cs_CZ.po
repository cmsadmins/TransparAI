msgstr "Banner (zavíratelný)"

#: admin/class-settings.php:464 includes/class-notice.php:632
msgid "Badge (small chip)"
msgstr "Odznak (malý štítek)"

#: admin/class-settings.php:465 includes/class-notice.php:633
