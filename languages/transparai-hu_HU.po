msgstr "Rátét a képen"

#: admin/class-settings.php:324 admin/class-wizard.php:376
#: admin/class-wizard.php:512
msgid "Dark"
msgstr "Sötét"

#: admin/class-settings.php:325 admin/class-wizard.php:377
#: admin/class-wizard.php:513
msgid "Light"
msgstr "Világos"

#: admin/class-settings.php:326 admin/class-wizard.php:378
#: admin/class-wizard.php:514
msgid "Outline"
msgstr "Körvonalas"

#: admin/class-settings.php:327 admin/class-wizard.php:379
msgid "Icon only (short label)"
msgstr "Csak ikon (rövid címke)"

#: admin/class-settings.php:351 admin/class-wizard.php:401
msgid "Small"
msgstr "Kicsi"

#: admin/class-settings.php:352 admin/class-wizard.php:402
