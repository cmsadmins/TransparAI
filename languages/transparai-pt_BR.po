msgstr "Este site tem um chat?"

#: admin/class-settings.php:558
msgid "Not decided yet"
msgstr "Ainda não decidido"

#: admin/class-settings.php:567
msgid "An AI answers"
msgstr "Uma IA responde"

#: admin/class-settings.php:568
msgid "People answer, an AI sometimes"
msgstr "Pessoas respondem, às vezes uma IA"

#: admin/class-settings.php:569
msgid "Only people answer"
msgstr "Só pessoas respondem"

#: admin/class-settings.php:573
