#. Plugin Name of the plugin
#: transparai.php
msgid "TransparAI: AI Image Detection & EU AI Act Labeling"
msgstr ""

#. Plugin URI of the plugin
#: transparai.php
msgid "https://wordpress.org/plugins/transparai/"
msgstr ""

#. Description of the plugin
#: transparai.php
msgid "Detect AI images from C2PA Content Credentials and IPTC metadata, label them with a visible AI badge and a machine-readable EU AI Act disclosure."
msgstr "Rileva le immagini generate dall'IA dalle Content Credentials C2PA e dai metadati IPTC, le contrassegna con un badge visibile e una dichiarazione leggibile dalle macchine per il regolamento europeo sull'IA."

