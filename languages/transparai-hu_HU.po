msgstr "érvénytelen, a tanúsítvány az aláírás időpontjában nem volt érvényes"

#: admin/class-media-library.php:398
msgid "invalid, the certificate is not allowed to sign Content Credentials"
msgstr ""
"érvénytelen, a tanúsítvány nem jogosult Content Credentials aláírására"

#: admin/class-media-library.php:400
