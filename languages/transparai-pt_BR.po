#: admin/class-settings.php:643
msgid "Standard declarations"
msgstr "Declarações padronizadas"

#: admin/class-settings.php:650 admin/class-settings.php:667
msgid "Label automatically"
msgstr "Rotular automaticamente"

#: admin/class-settings.php:651 admin/class-settings.php:668
msgid "Put into review queue"
msgstr "Colocar na fila de revisão"

#: admin/class-settings.php:652 admin/class-settings.php:669
msgid "Ignore"
msgstr "Ignorar"

#: admin/class-settings.php:656
