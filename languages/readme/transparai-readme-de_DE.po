msgid "<strong>Automatic AI image detection</strong>"
msgstr "<strong>Automatische KI-Bilderkennung</strong>"

#. Found in description header.
msgid "Disclaimer"
msgstr "Haftungsausschluss"

#. Found in description header.
msgid "Privacy"
msgstr "Datenschutz"

