#: transparai.php
msgid "TransparAI: EU AI Act Compliance, AI Disclosure & AI Image Detection"
msgstr ""
"TransparAI: tekoälyasetus (EU AI Act), tekoälymerkintä & tekoälykuvien "
"tunnistus"

#. Plugin URI of the plugin
#: transparai.php
msgid "https://wordpress.org/plugins/transparai/"
msgstr "https://wordpress.org/plugins/transparai/"

#. Description of the plugin
#: transparai.php
