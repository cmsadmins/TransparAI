#. Plugin Name of the plugin
#: transparai.php
msgid "TransparAI: AI Image Detection, EU AI Act Labeling & SEO"
msgstr ""

#. Plugin URI of the plugin
#: transparai.php
msgid "https://wordpress.org/plugins/transparai/"
msgstr ""

#. Description of the plugin
#: transparai.php
msgid "Detect AI images from C2PA Content Credentials and IPTC metadata, label them with a visible AI badge and a machine-readable EU AI Act disclosure."
msgstr "Detecta imágenes de IA a partir de las Content Credentials de C2PA y los metadatos IPTC, las señala con una insignia visible y una declaración legible por máquina para el Reglamento europeo de IA."

