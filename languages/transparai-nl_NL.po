msgstr "Begrepen: geen juridisch advies, geen aansprakelijkheid"

#: admin/class-dashboard.php:145 admin/class-settings.php:132
msgid "Not legal advice, no liability"
msgstr "Geen juridisch advies, geen aansprakelijkheid"

