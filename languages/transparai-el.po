#. Plugin Name of the plugin
#: transparai.php
msgid "TransparAI: EU AI Act Compliance, AI Disclosure & AI Image Detection"
msgstr ""
"TransparAI: Συμμόρφωση EU AI Act, σήμανση περιεχομένου AI & ανίχνευση "
"εικόνων AI"

#. Plugin URI of the plugin
#: transparai.php
msgid "https://wordpress.org/plugins/transparai/"
msgstr "https://wordpress.org/plugins/transparai/"

#. Description of the plugin
#: transparai.php
msgid ""
"Detect AI images via C2PA and IPTC, disclose AI content and chatbots, track "
"EU AI Act readiness with a score, self-assessment and compliance report."
msgstr ""
"Ανίχνευση εικόνων AI μέσω C2PA και IPTC, σήμανση περιεχομένου AI και "
"chatbot, βαθμολογία ετοιμότητας και αναφορά για τον EU AI Act."

#. Author of the plugin
#: transparai.php
msgid "Patrick Schlesinger"
msgstr "Patrick Schlesinger"

