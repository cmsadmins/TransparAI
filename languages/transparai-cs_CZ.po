#, php-format
msgid "Media library: %1$d of %2$d files scanned."
msgstr "Knihovna médií: skenováno %1$d z %2$d souborů."

#. translators: %s: badge style name.
#: admin/class-wizard.php:431
#, php-format
msgid "Visible badge: on, style \"%s\"."
msgstr "Viditelný odznak: zapnuto, styl „%s“."

#: admin/class-wizard.php:432
msgid "Visible badge: off."
msgstr "Viditelný odznak: vypnuto."

#: admin/class-wizard.php:436
msgid "File metadata: written into labeled files."
msgstr "Metadata souboru: zapisují se do označených souborů."

#: admin/class-wizard.php:436
msgid "File metadata: not written."
msgstr "Metadata souboru: nezapisují se."

#. translators: %d: readiness score from 0 to 100.
#: admin/class-wizard.php:442
#, php-format
msgid "Readiness score: %d of 100."
msgstr "Skóre připravenosti: %d ze 100."

#: admin/class-wizard.php:451
msgid "What your answers make relevant"
msgstr "Co je podle vašich odpovědí relevantní"

#: admin/class-wizard.php:462
msgid ""
"The dashboard keeps the score and the open steps in view. This assistant "
"stays available from the dashboard and the settings."
msgstr ""
"Ovládací panel má skóre i otevřené kroky stále na očích. Tento průvodce "
"zůstává dostupný z ovládacího panelu i z nastavení."

#: admin/class-dashboard.php:410 admin/class-settings.php:902
msgid "Export audit JSON"
msgstr "Exportovat auditní JSON"

#: admin/class-settings.php:406
msgid ""
"Show the full label as a native browser tooltip on icon-only image overlays "
"(no JavaScript required)"
msgstr ""
"Zobrazit celé označení jako nativní tip prohlížeče u překryvů jen s ikonou "
"(bez JavaScriptu)"

#: admin/class-settings.php:407
msgid ""
"Applies to Overlay on the image and Icon only (short label). Native tooltips"
" appear on mouse hover; touch and keyboard support depends on the browser. "
"The full label remains available to screen readers."
msgstr ""
"Platí pro „Překryv na obrázku“ a „Jen ikona (krátké označení)“. Nativní tip "
"se zobrazí po najetí myší; podpora dotyku a klávesnice závisí na prohlížeči."
" Celé označení zůstává dostupné čtečkám obrazovky."
