#. Plugin Name of the plugin
#: transparai.php
msgid "TransparAI: EU AI Act Compliance, AI Disclosure & AI Image Detection"
msgstr ""
"TransparAI: Conformità AI Act UE, dichiarazione IA & rilevamento immagini IA"

#. Plugin URI of the plugin
#: transparai.php
msgid "https://wordpress.org/plugins/transparai/"
msgstr "https://wordpress.org/plugins/transparai/"

#. Description of the plugin
#: transparai.php
msgid ""
"Detect AI images via C2PA and IPTC, disclose AI content and chatbots, track "
"EU AI Act readiness with a score, self-assessment and compliance report."
msgstr ""
"Rileva le immagini IA tramite C2PA e IPTC, dichiara contenuti IA e chatbot, "
"tiene traccia della preparazione all'EU AI Act con un punteggio, "
"un'autovalutazione e un rapporto di conformità."

#. Author of the plugin
#: transparai.php
