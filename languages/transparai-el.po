msgstr "Μόνο εκεί όπου έχει τοποθετηθεί μπλοκ ή shortcode"

#: admin/class-settings.php:430 includes/class-notice.php:629
msgid "Block (own line)"
msgstr "Μπλοκ (σε δική του γραμμή)"

#: admin/class-settings.php:431 includes/class-notice.php:630
