msgstr ""
"ongeldig, het certificaat was op het moment van ondertekenen niet geldig"

#: admin/class-media-library.php:399
msgid "invalid, the certificate is not allowed to sign Content Credentials"
msgstr "ongeldig, het certificaat mag geen Content Credentials ondertekenen"

